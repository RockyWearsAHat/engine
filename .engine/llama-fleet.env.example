# Copy to .engine/llama-fleet.env and edit values.

# Required: choose one model source.
# LLAMA_MODEL_PATH=/absolute/path/to/model.gguf
LLAMA_HF_REPO=bartowski/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
LLAMA_HF_FILE=

# Model alias seen by OpenAI-compatible clients.
LLAMA_MODEL_NAME=qwen2.5-1.5b

# Backend process topology.
LLAMA_HOST=127.0.0.1
LLAMA_PORTS=8081,8082,8083
LLAMA_PARALLEL=3
LLAMA_CTX=16384
LLAMA_THREADS=8
LLAMA_THREADS_BATCH=8
LLAMA_THREADS_HTTP=8
LLAMA_BATCH=512
LLAMA_UBATCH=128
LLAMA_N_GPU_LAYERS=0
LLAMA_DEFRAG_THOLD=0.2
LLAMA_FLASH_ATTN=0
LLAMA_MLOCK=0
LLAMA_NO_MMAP=0
# LLAMA_NUMA=distribute

# Router endpoint consumed by Engine.
LLAMA_ROUTER_HOST=127.0.0.1
LLAMA_ROUTER_PORT=8080
