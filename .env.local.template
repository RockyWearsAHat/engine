# Environment configuration template for Engine autonomous build pipeline.
# Copy this file to .env.local and fill in the values for your setup.
# Use `source .env.local` to load variables into your shell.

# STEP 3: Environment & Credentials
# GitHub token for API access and repository operations
export GITHUB_TOKEN=your-github-token-here

# GitHub repository owner (used in repo scaffolding)
export ENGINE_GITHUB_OWNER=your-org-or-username

# GitHub repository name (used in repo scaffolding)
export ENGINE_GITHUB_REPO=your-repo-name

# STEP 4+: Optional integrations (uncomment to enable)

# Bot-specific GitHub token for Discord bridge integration
# ENGINE_GITHUB_BOT_TOKEN=your-bot-token-here

# Bot GitHub login name for commit attribution
# ENGINE_GITHUB_LOGIN=your-bot-username

# Bot GitHub display name for commit attribution
# ENGINE_GITHUB_DISPLAY_NAME="Your Bot Name"

# Bot GitHub email for commit attribution
# ENGINE_GITHUB_BOT_EMAIL=bot@example.com

# GitHub project owner (for Projects V2 engagement)
# ENGINE_GITHUB_PROJECT_OWNER=your-org

# GitHub project number (for Projects V2 engagement)
# ENGINE_GITHUB_PROJECT_NUMBER=42

# Discord bot token for control commands and issue bridge
# ENGINE_DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord guild ID (server) where bot commands are enabled
# ENGINE_DISCORD_GUILD_ID=your-guild-id

# Discord control channel ID for bot commands
# ENGINE_DISCORD_CONTROL_CHANNEL=your-channel-id

# Discord bot command prefix
# ENGINE_DISCORD_PREFIX=!

# Comma-separated list of allowed Discord user IDs
# ENGINE_DISCORD_ALLOWED_USER_IDS=user-id-1,user-id-2

# Enable/disable Discord integration (true/false)
# ENGINE_DISCORD=false

# STEP 5+: Model configuration

# Anthropic API key for Claude models
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Primary model provider (anthropic, ollama, llamacpp, etc.)
# ENGINE_MODEL_PROVIDER=anthropic

# Primary model ID
# ENGINE_MODEL=claude-opus-5

# Planner role model provider override
# ENGINE_PLANNER_PROVIDER=anthropic

# Planner role model ID override
# ENGINE_PLANNER_MODEL=claude-sonnet-5

# Reviewer role model provider override
# ENGINE_REVIEWER_PROVIDER=anthropic

# Reviewer role model ID override
# ENGINE_REVIEWER_MODEL=claude-sonnet-5

# Quota tracking: comma-separated list of Claude accounts (format: email:plan)
# ENGINE_CLAUDE_ACCOUNTS=user@example.com:pro,another@example.com:free

# Quota tracking: enable quota enforcement (true/false)
# ENGINE_QUOTA=true

# Local model mesh configuration

# Ollama model to use for local inference
# ENGINE_OLLAMA_MODEL=neural-chat

# Llama.cpp model to use for local inference
# ENGINE_LLAMACPP_MODEL=/path/to/model.gguf

# Workspace directory for orchestrator work
# ENGINE_WORKSPACE_DIR=/path/to/workspace

# Developer/testing options (usually not needed)

# Enable live tests against real Anthropic API
# ENGINE_LIVE_CLAUDECODE=0

# Claude Code idle timeout in seconds
# ENGINE_CLAUDECODE_IDLE_TIMEOUT_SEC=300

# Quota cheap model for cost optimization
# ENGINE_QUOTA_CHEAP_MODEL=claude-haiku-3

# Quota mid model for balanced tasks
# ENGINE_QUOTA_MID_MODEL=claude-sonnet-3

# Quota heavy model for complex reasoning
# ENGINE_QUOTA_HEAVY_MODEL=claude-opus-5

# Quota ledger for tracking (file path)
# ENGINE_QUOTA_LEDGER=.engine/quota.ledger

# Active team selection
# ENGINE_ACTIVE_TEAM=main
